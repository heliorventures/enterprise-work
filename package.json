{
  "name": "work-management-platform",
  "private": true,
  "version": "1.0.0",
  "description": "Enterprise Work & Outcome Management Platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run start:dev -w @wmp/api\" \"npm run dev -w @wmp/web\"",
    "dev:api": "npm run start:dev -w @wmp/api",
    "dev:web": "npm run dev -w @wmp/web",
    "build": "npm run build -w @wmp/api && npm run build -w @wmp/web",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:seed": "prisma db seed",
    "prisma:studio": "prisma studio",
    "test": "npm run test -w @wmp/api && npm run test -w @wmp/web",
    "test:api": "npm run test -w @wmp/api",
    "test:web": "npm run test -w @wmp/web",
    "lint": "npm run lint -w @wmp/api && npm run lint -w @wmp/web"
  },
  "prisma": {
    "schema": "prisma/schema.prisma",
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.6.0",
    "bcrypt": "^5.1.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "concurrently": "^9.1.2",
    "playwright": "^1.63.0",
    "prisma": "^6.6.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  },
  "engines": {
    "node": ">=20"
  }
}
